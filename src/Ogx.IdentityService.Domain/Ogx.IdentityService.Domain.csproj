<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.version.props" />
    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>Ogx.IdentityService.Domain</PackageId>
        <RootNamespace>Ogx.IdentityService.Domain</RootNamespace>
        <Title>HsnSoft Ogx Identity Service Domain</Title>
        <Description>HsnSoft Ogx Identity Service Domain</Description>
        <PackageTags>HsnSoft Ogx Identity Service Domain</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(MicrosoftAspNetCorePackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HsnSoft.Base.Ddd.Domain" Version="$(HsnSoftFrameworkVersion)" />
        <!--<ProjectReference Include="..\..\..\..\..\..\hsn-soft\base-framework\src\HsnSoft.Base.Ddd.Domain\HsnSoft.Base.Ddd.Domain.csproj" />-->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ogx.Shared.Helper" Version="$(OgxSharedVersion)" />
        <!--<ProjectReference Include="..\..\..\..\shared\src\Ogx.Shared.Helper\Ogx.Shared.Helper.csproj" />-->
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\IdentityService\*.json" />
        <Content Remove="Localization\IdentityService\*.json" />
    </ItemGroup>

</Project>
